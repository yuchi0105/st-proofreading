{
  "name": "清新简体预设",
  "chat_completion_source": "openai",
  "openai_model": "gpt-test",
  "temperature": 0.8,
  "new_chat_prompt": "开始新的故事，保留 {{user}}。",
  "prompts": [
    {
      "identifier": "main",
      "name": "主要提示",
      "role": "system",
      "content": "角色皮肤很苍白，系统返回错误信息。\n{{user}} 😀",
      "system_prompt": true,
      "unknown_prompt_field": "keep-main"
    },
    {
      "identifier": "charDescription",
      "name": "角色描述",
      "role": "system",
      "marker": true
    },
    {
      "identifier": "style",
      "name": "写作风格",
      "role": "user",
      "content": "使用细腻的简体中文描写。",
      "injection_position": 1,
      "injection_depth": 4
    },
    {
      "identifier": "unused",
      "name": "未加入顺序",
      "role": "system",
      "content": "这个提示尚未加入顺序。"
    }
  ],
  "prompt_order": [
    {
      "character_id": 100000,
      "order": [
        { "identifier": "main", "enabled": true },
        { "identifier": "charDescription", "enabled": true },
        { "identifier": "style", "enabled": false }
      ],
      "unknown_order_field": "keep-order"
    },
    {
      "character_id": 100001,
      "order": [
        { "identifier": "main", "enabled": false }
      ]
    }
  ],
  "extensions": {
    "regex_scripts": [
      {
        "id": "rx-preset-1",
        "scriptName": "皮肤样式",
        "findRegex": "/角色皮肤/g",
        "replaceString": "<span class=\"skin\">皮肤信息</span>",
        "trimStrings": ["错误信息", "角色皮肤"],
        "disabled": false,
        "placement": [2],
        "promptOnly": true,
        "unknown_regex_field": "keep-regex"
      },
      {
        "id": "rx-preset-2",
        "scriptName": "停用脚本",
        "findRegex": "/简体中文/g",
        "replaceString": "繁体中文",
        "disabled": true
      }
    ],
    "unknown_extension": { "keep": true }
  },
  "unknown_preset_field": ["keep", 7]
}
